APP_NAME="PLT Social"
APP_ENV=local
APP_KEY=base64:E7kIUDwIzCl4nop+yFuIErH7xmo2fG+hGYayDHZuQv8=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jindo_plt_social
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Media uploads (avatars, covers, posts, messages) use MEDIA_DISK — not FILESYSTEM_DISK.
MEDIA_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Local Redis: `make redis` (docker compose). Without it, cache/queue artisan commands fail.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=plt-social
REVERB_APP_KEY=a1b2c3d4e5f67890abcdef1234567890
REVERB_APP_SECRET=92878ce7f411055651163851f4633b82
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production object storage for user media:
# MEDIA_DISK=s3
# (Backfill: see docs/design/006-phase7-ops.md)
# Horizon: php artisan horizon (admin dashboard /horizon) — local/VPS with Redis only.

# ---------------------------------------------------------------------------
# cPanel production drivers (server .env only — never commit)
# See docs/OPS_RUNBOOK.md. Typical shared hosting:
#   APP_ENV=production
#   APP_DEBUG=false
#   DB_HOST=localhost
#   CACHE_STORE=database
#   QUEUE_CONNECTION=database
#   BROADCAST_CONNECTION=log
#   MEDIA_DISK=public
#   LOG_LEVEL=error
# Do not run Horizon / Reverb / Redis on shared cPanel.
# ---------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
